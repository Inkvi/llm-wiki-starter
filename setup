#!/usr/bin/env bash
# One-time bootstrap for a vault cloned from llm-wiki-starter.
#
# Does only the mechanical work: check and optionally install the tools the vault
# needs, detach from the template's git history, create the two gitignored
# folders a clone cannot carry, fetch the Obsidian agent skills, and make a
# baseline commit. Everything requiring a decision about *your life* is left to
# the vault-setup skill, so the agent writes the schema it is going to read.
#
# Safe to run twice. Refuses to touch a git history that is not the template's.
# Never installs anything without asking, and never runs sudo without telling you.
#
# Usage: ./setup [--yes] [--no-install] [--help]

set -euo pipefail

TEMPLATE_SLUG="llm-wiki-starter"
ASSUME_YES=0
NO_INSTALL=0

while [ $# -gt 0 ]; do
  case "$1" in
    --yes|-y)    ASSUME_YES=1 ;;
    --no-install) NO_INSTALL=1 ;;
    --help|-h)
      sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) printf 'unknown option: %s (try --help)\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

say()  { printf '%s\n' "$*"; }
ok()   { printf '  ok      %s\n' "$*"; }
skip() { printf '  skip    %s\n' "$*"; }
warn() { printf '  missing %s\n' "$*"; }
note() { printf '          %s\n' "$*"; }
die()  { printf '\nstopped: %s\n' "$*" >&2; exit 1; }

cd "$(dirname "$0")"

# --- 0. where are we, and what installs software here? -----------------------

[ -f CLAUDE.md ] && [ -d "20 Wiki" ] || die "this does not look like a vault root (no CLAUDE.md and 20 Wiki/ here)"

PKG=""
PKG_SUDO=""
if   command -v brew    >/dev/null 2>&1; then PKG="brew"
elif command -v apt-get >/dev/null 2>&1; then PKG="apt";    PKG_SUDO="sudo"
elif command -v dnf     >/dev/null 2>&1; then PKG="dnf";    PKG_SUDO="sudo"
elif command -v pacman  >/dev/null 2>&1; then PKG="pacman"; PKG_SUDO="sudo"
fi

say "Setting up vault in $(pwd)"
[ -n "$PKG" ] && say "Package manager: $PKG" || say "Package manager: none detected, will print install commands instead"
say ""

# Ask a yes/no question. Declines automatically when there is no terminal to ask
# on, so piping this script into a shell never hangs waiting for input.
ask() {
  [ "$ASSUME_YES" = "1" ] && return 0
  [ -t 0 ] || return 1
  printf '          install it now? [y/N] '
  read -r reply || return 1
  # Strip a trailing carriage return: ptys and Windows shells deliver "y\r",
  # which silently fails an exact match and reads to the user as being ignored.
  reply="${reply%$'\r'}"
  case "$reply" in [yY]|[yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}

# Print the command that would install $1, for the detected package manager.
install_cmd() {
  case "$PKG" in
    brew)   printf 'brew install %s' "$1" ;;
    apt)    printf 'sudo apt-get install -y %s' "$1" ;;
    dnf)    printf 'sudo dnf install -y %s' "$1" ;;
    pacman) printf 'sudo pacman -S --noconfirm %s' "$1" ;;
    *)      printf '' ;;
  esac
}

run_install() {
  local pkgname="$1" cmd
  cmd="$(install_cmd "$pkgname")"
  [ -n "$cmd" ] || return 1
  [ -n "$PKG_SUDO" ] && note "this needs sudo: $cmd"
  # shellcheck disable=SC2086
  eval "$cmd"
}

# need <command> <package> <required|recommended> <why>
need() {
  local cmd="$1" pkgname="$2" level="$3" why="$4"
  if command -v "$cmd" >/dev/null 2>&1; then
    ok "$cmd"
    return 0
  fi

  warn "$cmd  ($level)"
  note "$why"

  local hint
  hint="$(install_cmd "$pkgname")"

  if [ "$NO_INSTALL" = "1" ] || [ -z "$hint" ]; then
    [ -n "$hint" ] && note "install with: $hint" || note "no package manager detected; install it yourself (package is usually called \"$pkgname\")"
  elif ask; then
    if run_install "$pkgname" && command -v "$cmd" >/dev/null 2>&1; then
      ok "$cmd installed"
      return 0
    fi
    note "installation did not succeed; try manually: $hint"
  else
    note "skipped. install later with: $hint"
  fi

  if [ "$level" = "required" ]; then
    die "$cmd is required and is not available. Install it and run ./setup again."
  fi
  return 1
}

# --- 1. prerequisites --------------------------------------------------------

say "Checking tools"

need git git required \
  "the vault is a git repo; git is what makes every agent edit a reviewable diff"

need python3 python3 required \
  "the three maintenance scripts are plain Python 3 and are run on every lint pass"

# python3 exists but may be too old for the scripts.
if command -v python3 >/dev/null 2>&1; then
  if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3,8) else 1)' 2>/dev/null; then
    warn "python3 is older than 3.8"
    note "the maintenance scripts may not run; upgrading is recommended"
  fi
fi

need pdftotext poppler recommended \
  "used to triage PDFs: find which page holds a value, or confirm a transcription" \
  || note "without it, PDFs must be read by the agent's vision on every pass"

say ""

# qmd is deliberately handled separately: it is genuinely not needed yet on a
# brand-new vault, and installing it via npm has its own prerequisite.
if command -v qmd >/dev/null 2>&1; then
  ok "qmd  (full-text and semantic vault search)"
elif [ "$NO_INSTALL" = "1" ]; then
  skip "qmd not installed; index-first navigation is fine until a few hundred sources"
elif command -v npm >/dev/null 2>&1; then
  warn "qmd  (optional, and not needed yet)"
  note "qmd adds local full-text and semantic search. Index-first navigation in"
  note "index.md is fine until roughly a few hundred sources, so it is genuinely"
  note "reasonable to skip this and add it the day search starts feeling slow."
  if ask; then
    npm config set prefix ~/.npm-global >/dev/null 2>&1 || true
    if npm install -g @tobilu/qmd >/dev/null 2>&1 && command -v qmd >/dev/null 2>&1; then
      qmd collection add "$(pwd)" --name vault >/dev/null 2>&1 \
        && ok "qmd installed and this vault indexed as collection 'vault'" \
        || ok "qmd installed (index it later with: qmd collection add \"\$(pwd)\" --name vault)"
    else
      note "install did not succeed. If ~/.npm-global/bin is not on your PATH, add it."
      note "manual: npm install -g @tobilu/qmd"
    fi
  else
    note "skipped. later: npm install -g @tobilu/qmd && qmd collection add \"\$(pwd)\" --name vault"
  fi
else
  skip "qmd needs Node/npm, which is not installed; skipping (not needed yet anyway)"
fi

# Obsidian is a GUI app and only the viewer, so it is never worth blocking on.
if [ -d "/Applications/Obsidian.app" ] || command -v obsidian >/dev/null 2>&1; then
  ok "Obsidian"
elif [ "$PKG" = "brew" ] && [ "$NO_INSTALL" != "1" ]; then
  warn "Obsidian  (optional)"
  note "only the viewer and editor: nothing breaks without it, but wikilinks,"
  note "graph view and dashboard.base stop working. Needs 1.9+ for Bases."
  if ask; then
    brew install --cask obsidian && ok "Obsidian installed" || note "manual: brew install --cask obsidian"
  else
    note "skipped. later: brew install --cask obsidian"
  fi
else
  skip "Obsidian not detected (optional; get it at https://obsidian.md)"
fi

say ""
say "Setting up the vault"

# --- 2. detach from the template --------------------------------------------
# A clone keeps the template as origin. Left in place, a stray 'git push' would
# send private notes to a public repo, so the history is replaced rather than
# reused. Only ever removed when origin really is the template.
if [ -e .git ]; then
  origin="$(git remote get-url origin 2>/dev/null || true)"
  if [ -z "$origin" ]; then
    skip "existing git history has no origin, leaving it alone"
  elif printf '%s' "$origin" | grep -q "$TEMPLATE_SLUG"; then
    rm -rf .git
    ok "removed the template's git history and remote"
  else
    die "origin is $origin, which is not the template.
         This looks like your own repo, so nothing was changed.
         If you really want a fresh history here, remove .git yourself first."
  fi
else
  skip "no git history to detach"
fi

# --- 3. folders a clone cannot carry ----------------------------------------
# Both are gitignored on purpose: the Inbox is staging, not a record, and
# Attachments holds binaries. Neither survives a clone, so create them.
for d in "00 Inbox" "Attachments"; do
  if [ -d "$d" ]; then skip "$d/ exists"; else mkdir -p "$d"; ok "created $d/"; fi
done

# --- 4. Obsidian agent skills (optional) ------------------------------------
# kepano/obsidian-skills teaches an agent Obsidian-flavoured markdown, Bases
# syntax, JSON Canvas, the CLI, and Defuddle. Nice to have, not required.
if [ -d ".claude/skills/obsidian-markdown" ]; then
  skip "Obsidian agent skills already installed"
elif git ls-remote --exit-code https://github.com/kepano/obsidian-skills >/dev/null 2>&1; then
  tmp="$(mktemp -d)"
  if git clone --depth 1 --quiet https://github.com/kepano/obsidian-skills "$tmp/os" 2>/dev/null \
     && [ -d "$tmp/os/skills" ]; then
    cp -R "$tmp/os/skills/." .claude/skills/
    ok "installed Obsidian agent skills from kepano/obsidian-skills"
  else
    skip "could not fetch Obsidian agent skills, continuing without them"
  fi
  rm -rf "$tmp"
else
  skip "no network for Obsidian agent skills, continuing without them"
fi

# --- 5. harness compatibility links -----------------------------------------
# Claude Code discovers skills in .claude/skills, Codex in .agents/skills. The
# repo ships one copy of each skill under .claude/ and symlinks it into .agents/
# so both harnesses see the same file. git on Windows does not always create
# symlinks on checkout, which would silently leave Codex with no skills, so
# recreate anything that did not survive the clone.
if [ -d ".claude/skills" ]; then
  for name in vault-setup vault-maintenance; do
    [ -d ".claude/skills/$name" ] || continue
    link=".agents/skills/$name"
    if [ -L "$link" ] && [ -d "$link" ]; then
      skip "$link"
    else
      mkdir -p .agents/skills
      rm -rf "$link"
      ln -s "../../.claude/skills/$name" "$link" && ok "linked $link for Codex"
    fi
  done
fi

# Same problem, same fix: AGENTS.md is a symlink to CLAUDE.md so both harnesses
# load one schema. A Windows checkout can leave it as a file containing a path.
if [ ! -L AGENTS.md ] && [ -f AGENTS.md ] && [ "$(head -c 20 AGENTS.md)" = "CLAUDE.md" ]; then
  rm -f AGENTS.md && ln -s CLAUDE.md AGENTS.md && ok "restored the AGENTS.md symlink"
fi

# --- 6. baseline commit -----------------------------------------------------
# Committing now means the vault-setup skill's changes land as their own diff,
# so you can see exactly what onboarding decided on your behalf.
if [ -e .git ]; then
  skip "git already initialised"
else
  git init --quiet
  git add -A
  if git -c user.name="vault" -c user.email="vault@localhost" \
       commit --quiet -m "setup: vault from llm-wiki-starter" 2>/dev/null; then
    ok "git initialised with a baseline commit"
  else
    skip "git initialised, but the baseline commit failed (set user.name and user.email, then commit)"
  fi
fi

# --- next ------------------------------------------------------------------
say ""
say "Done. One step left, and it needs an agent rather than a script."
say ""
say "  1. Optional but recommended: drop a few real documents into '00 Inbox/'."
say "     The onboarding skill reads them to propose your life areas, which"
say "     beats inventing a folder taxonomy from a blank page."
say ""
say "  2. Open this folder in your agent and ask for the vault-setup skill."
say "     Claude Code:  /vault-setup"
say "     Codex:        use the vault-setup skill"
say "     Anything else: read .claude/skills/vault-setup/SKILL.md and follow it"
say ""
say "It will interview you briefly, write your schema into CLAUDE.md, create"
say "your area folders, and commit. Then you are ready to ingest."
